# Server
PORT=3000
NODE_ENV=development

# MongoDB. Do not put production credentials in this file.
MONGODB_URI=mongodb://localhost:27017/cheap_grocery

# Authentication. Set these in your local .env; never commit real secrets.
SESSION_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=10

# Comma-separated browser origins allowed to call this API in development.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
